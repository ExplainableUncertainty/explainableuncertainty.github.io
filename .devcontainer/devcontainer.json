{
	"name": "XUQ Explorer — Explainable Uncertainty Quantification",
	// Pin to Node 22 (project requirement: Astro 7 needs >= 22.23.4)
	"image": "mcr.microsoft.com/devcontainers/typescript-node:22",
	"features": {
		"ghcr.io/devcontainers/features/git:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	// Forward Astro's dev server port
	"forwardPorts": [4321],
	"portsAttributes": {
		"4321": {
			"label": "Astro dev server",
			"onAutoForward": "notify"
		}
	},
	// Install site dependencies on creation so `npm run dev` works immediately
	"postCreateCommand": "cd site && npm install",
	"customizations": {
		"vscode": {
			"extensions": [
				"astro-build.astro-vscode",
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode"
			],
			"settings": {
				"editor.formatOnSave": true,
				"editor.defaultFormatter": "esbenp.prettier-vscode"
			}
		}
	},
	// The utility venv is optional in the container (paper-content extraction
	// only); uncomment if needed:
	// "postCreateCommand": "cd site && npm install && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
	"remoteUser": "node"
}