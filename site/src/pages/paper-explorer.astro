---
// paper-explorer.astro — interactive tables of the 53 reviewed papers.
// Three tables (ML Tasks / XUQ Methods / XUQ Evaluation), each with the general
// columns always shown. Cells render as colored, clickable labels.
import BaseLayout from '../layouts/BaseLayout.astro';
import papers from '../data/papers.json';
import '../styles/profile-popup.css';
import { COLUMNS, GROUPS, TABLE_GROUPS, getTableColumns, getValue, formatValue, labelColor, labelBg } from '../data/paperTypes';
import { valueLabel } from '../data/valueLabels';
import type { Paper } from '../data/paperTypes';
import type { ColumnGroup } from '../data/paperTypes';

// Humanize a snake_case / spaced label for display, preferring curated labels.
function humanizeLabel(s: string): string {
	return valueLabel(s) !== s ? valueLabel(s) : s.replace(/_/g, ' ').replace(/\s+/g, ' ').trim();
}

// Table labels for the switcher.
const TABLE_LABELS: Record<ColumnGroup, string> = {
	ml_task: 'Research Context',
	xuq_method: 'XUQ Methods',
	xuq_evaluation: 'XUQ Evaluation',
	general: 'General',
};
---

<BaseLayout
	title="Paper Explorer"
	description="Browse the 53 reviewed papers and their classification across the XUQ taxonomy."
	currentPath="/paper-explorer"
>
	<article class="explorer">
		<header class="explorer__header">
			<h1>Paper Explorer</h1>
			<p>
				This page lists all <strong>{papers.length} papers</strong> included in the systematic literature
				review. You can switch between three tables: Research Context, XUQ Methods, and XUQ Evaluation.
				Clicking on a paper's ID or title opens its full profile.
			</p>
		</header>

		<!-- Table switcher -->
		<div class="explorer__tabs" role="tablist" aria-label="Choose table">
			{
				TABLE_GROUPS.map((g, i) => (
					<button
						class:list={['tab', `tab--${g}`, { 'tab--active': i === 0 }]}
						role="tab"
						aria-selected={i === 0}
						data-table-tab={g}
						style={`--tab-color:${GROUPS.find((gr) => gr.id === g)?.color};--tab-bg:${GROUPS.find((gr) => gr.id === g)?.bg}`}
					>
						{TABLE_LABELS[g]}
					</button>
				))
			}
		</div>

		<!-- Controls -->
		<div class="explorer__controls">
			<div class="explorer__search">
				<label class="sr-only" for="explorer-search">Search papers</label>
				<input
					id="explorer-search"
					type="search"
					placeholder="Search title, author, venue, category…"
					data-search-input
				/>
			</div>
			<span class="explorer__tab-count" data-tab-count aria-live="polite">
				{papers.length} papers
			</span>
		</div>

		<!-- Table card -->
		<div class="table-card">
			<!-- Card header: filter button + counter -->
			<div class="table-card__header">
				<button class="filter-btn" type="button" data-filter-toggle aria-expanded="false">
					<span class="filter-btn__icon" aria-hidden="true">⚲</span>
					<span>Filter</span>
					<span class="filter-btn__badge" data-filter-count hidden>0</span>
				</button>
				<span class="table-card__counter" data-result-count>
					{papers.length} of {papers.length} items
				</span>
			</div>

			<!-- Active filter chips (rendered by the script) -->
			<div class="active-filters" data-active-filters hidden></div>

			<!-- Filter panel -->
			<div class="filter-panel" data-filter-panel hidden>
				<div class="filter-panel__body" data-filter-panel-body></div>
				<div class="filter-panel__footer">
					<button class="filter-panel__clear" type="button" data-clear-filters>Clear all filters</button>
				</div>
			</div>

			<!-- Three tables, one visible at a time -->
			{
				TABLE_GROUPS.map((g, gi) => {
					const tableCols = getTableColumns(g);
					const groupColor = GROUPS.find((gr) => gr.id === g)?.color;
					const groupBg = GROUPS.find((gr) => gr.id === g)?.bg;
					return (
						<div
							class:list={['explorer__table-wrap', { 'explorer__table-wrap--active': gi === 0 }]}
							data-table-wrap={g}
							style={`--table-color:${groupColor};--table-bg:${groupBg}`}
						>
							<table class="explorer__table" data-explorer-table={g}>
								<thead>
									<tr>
										{
											tableCols.map((col) => (
												<th
													class:list={[`th--${col.group}`, { 'th--always': col.always }]}
													data-col={col.key}
													data-group={col.group}
													scope="col"
												>
													{
														col.key === 'id' || col.key === 'title' ? (
															<button
																class="th__sort"
																type="button"
																data-sort-col={col.key}
																aria-label={`Sort by ${col.label}`}
															>
																<span class="th__label">{col.label}</span>
																<span class="th__sort-arrow" data-sort-arrow={col.key} aria-hidden="true"></span>
															</button>
														) : (
															<span class="th__label">{col.label}</span>
														)
													}
													{
														col.isList && (
															<button
																class="th__filter"
																type="button"
																aria-label={`Filter by ${col.label}`}
																data-col-filter={col.key}
															>
																▾
															</button>
														)
													}
												</th>
											))
										}
									</tr>
								</thead>
								<tbody>
									{
										papers.map((paper: Paper, paperIndex: number) => {
																																						const displayId = String(paperIndex + 1);
																																						return (
																																						<tr data-paper-row data-paper-id={paper.id}>
												{
													tableCols.map((col) => {
														const value = getValue(paper, col.path);
														const isLink = col.key === 'id' || col.key === 'title';
														const isList = Array.isArray(value) && value.length > 0;
														const color = labelColor(col.group);
														const bg = labelBg(col.group);
														return (
															<td
																class:list={[`td--${col.group}`, { 'td--always': col.always }]}
																data-col={col.key}
																data-group={col.group}
															>
																{isLink ? (
																	<button
																		class="explorer__link"
																		type="button"
																		data-open-profile
																		data-paper-id={paper.id}
																	>
																		{col.key === 'id' ? displayId : formatValue(value)}
																	</button>
																) : isList ? (
																	<div class="cell__labels">
																		{(value as string[]).map((label) => (
																			<button
																				class="cell__label"
																				type="button"
																				style={`--label-color:${color};--label-bg:${bg}`}
																				data-filter-label
																				data-col={col.key}
																				data-label={label}
																				title={`Filter by ${label}`}
																			>
																				{humanizeLabel(label)}
																			</button>
																		))}
																	</div>
																) : (
																	<span>{formatValue(value)}</span>
																)}
															</td>
														);
													})
												}
											</tr>
										);
										})
									}
								</tbody>
							</table>
							<!-- Shown when search/filters match nothing -->
							<div class="table-empty" data-table-empty hidden>
								<p class="table-empty__title">No papers match your current search and filters.</p>
								<button class="table-empty__reset" type="button" data-empty-reset>Clear search &amp; filters</button>
							</div>
						</div>
					);
				})
			}
		</div>
	</article>

	<!-- Column filter dropdown -->
	<div class="filter-menu" data-filter-menu hidden></div>

	<!-- Paper profile popup -->
	<div class="profile" data-profile hidden>
		<div class="profile__backdrop" data-profile-close></div>
		<div class="profile__dialog" role="dialog" aria-modal="true" aria-labelledby="profile-title">
			<div class="profile__bar">
				<span class="profile__bar-label">Paper profile</span>
				<button class="profile__close" type="button" data-profile-close aria-label="Close paper profile">
					<svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
						<path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
					</svg>
				</button>
			</div>
			<div class="profile__body" data-profile-body></div>
		</div>
	</div>
</BaseLayout>

<script>
	import { COLUMNS, GROUPS, TABLE_GROUPS, getTableColumns, getValue, formatValue, labelColor, labelBg } from '../data/paperTypes';
	import type { Paper } from '../data/paperTypes';
	import type { ColumnGroup } from '../data/paperTypes';
	import papers from '../data/papers.json';
	import { valueLabel } from '../data/valueLabels';

	const searchInput = document.querySelector<HTMLInputElement>('[data-search-input]');
	const resultCount = document.querySelector<HTMLElement>('[data-result-count]');
	const profile = document.querySelector<HTMLElement>('[data-profile]');
	const profileBody = document.querySelector<HTMLElement>('[data-profile-body]');
	const filterMenu = document.querySelector<HTMLElement>('[data-filter-menu]');
	const filterToggle = document.querySelector<HTMLButtonElement>('[data-filter-toggle]');
	const filterPanel = document.querySelector<HTMLElement>('[data-filter-panel]');
	const filterPanelBody = document.querySelector<HTMLElement>('[data-filter-panel-body]');
	const filterCount = document.querySelector<HTMLElement>('[data-filter-count]');
	const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-table-tab]'));

	let activeTable: ColumnGroup = 'ml_task';
	let searchTerm = '';
	// Active label filters: { columnKey: Set<label> }
	const labelFilters = new Map<string, Set<string>>();
	// Sort state
	let sortCol = 'id';
	let sortDir: 'asc' | 'desc' = 'asc';

	// ---- URL state (shareable / refresh-safe views) ----
	// Query params: tab=<group>&q=<search>&f_<col>=<label>,<label>
	function readUrlState() {
		const params = new URLSearchParams(window.location.search);
		const tab = params.get('tab') as ColumnGroup | null;
		if (tab && TABLE_GROUPS.includes(tab)) activeTable = tab;
		searchTerm = params.get('q') ?? '';
		if (searchInput) searchInput.value = searchTerm;
		for (const [key, value] of params.entries()) {
			if (key.startsWith('f_') && value) {
				labelFilters.set(key.slice(2), new Set(value.split(',').filter(Boolean)));
			}
		}
	}

	let urlTimer: ReturnType<typeof setTimeout> | undefined;
	function writeUrlState() {
		// Debounced so rapid filter clicks don't spam history entries.
		clearTimeout(urlTimer);
		urlTimer = setTimeout(() => {
			const params = new URLSearchParams();
			params.set('tab', activeTable);
			if (searchTerm) params.set('q', searchTerm);
			labelFilters.forEach((labels, col) => {
				if (labels.size > 0) params.set(`f_${col}`, Array.from(labels).join(','));
			});
			const qs = params.toString();
			window.history.replaceState(null, '', qs ? `?${qs}` : window.location.pathname);
		}, 250);
	}

	// ---- Table switcher ----
	function switchTable(group: ColumnGroup) {
		activeTable = group;
		tabs.forEach((tab) => {
			const active = tab.dataset.tableTab === group;
			tab.classList.toggle('tab--active', active);
			tab.setAttribute('aria-selected', String(active));
		});
		document.querySelectorAll<HTMLElement>('[data-table-wrap]').forEach((wrap) => {
			wrap.classList.toggle('explorer__table-wrap--active', wrap.dataset.tableWrap === group);
		});
		buildFilterPanel();
		applyRowFilter();
		applySort();
		writeUrlState();
	}

	tabs.forEach((tab) => {
		tab.addEventListener('click', () => switchTable((tab.dataset.tableTab as ColumnGroup) ?? 'ml_task'));
	});

	// ---- Label filtering ----
	function toggleLabelFilter(col: string, label: string) {
		if (!labelFilters.has(col)) labelFilters.set(col, new Set());
		const set = labelFilters.get(col)!;
		if (set.has(label)) {
			set.delete(label);
			if (set.size === 0) labelFilters.delete(col);
		} else {
			set.add(label);
		}
		buildFilterPanel();
		renderFilterBadge();
		renderActiveFilters();
		applyRowFilter();
		writeUrlState();
	}

	function clearLabelFilters() {
		labelFilters.clear();
		buildFilterPanel();
		renderFilterBadge();
		renderActiveFilters();
		applyRowFilter();
		writeUrlState();
	}

	function countActiveFilters(): number {
		let n = 0;
		labelFilters.forEach((set) => (n += set.size));
		return n;
	}

	function renderFilterBadge() {
		if (!filterCount) return;
		const n = countActiveFilters();
		filterCount.hidden = n === 0;
		filterCount.textContent = String(n);
	}

	/** Render the removable chips for every active filter (visible on all tabs). */
	function renderActiveFilters() {
		const container = document.querySelector<HTMLElement>('[data-active-filters]');
		if (!container) return;
		const chips: string[] = [];
		labelFilters.forEach((labels, col) => {
			const colDef = COLUMNS.find((c) => c.key === col);
			const color = labelColor(colDef?.group ?? 'general');
			const bg = labelBg(colDef?.group ?? 'general');
			labels.forEach((label) => {
				chips.push(`
					<span class="active-filters__chip" style="--label-color:${color};--label-bg:${bg}">
						<span class="active-filters__col">${escapeHtml(colDef?.label ?? col)}:</span>
						${escapeHtml(humanizeLabel(label))}
						<button class="active-filters__remove" type="button" aria-label="Remove filter ${escapeHtml(humanizeLabel(label))}"
							data-chip-col="${escapeHtml(col)}" data-chip-label="${escapeHtml(label)}">×</button>
					</span>
				`);
			});
		});
		container.innerHTML = chips.join('');
		container.hidden = chips.length === 0;
		container.querySelectorAll<HTMLButtonElement>('[data-chip-col]').forEach((btn) => {
			btn.addEventListener('click', () => toggleLabelFilter(btn.dataset.chipCol ?? '', btn.dataset.chipLabel ?? ''));
		});
	}

	// ---- Filter panel (only shows columns of the active table) ----
	function buildFilterPanel() {
		if (!filterPanelBody) return;
		const tableCols = getTableColumns(activeTable);
		const sections = tableCols
			.filter((c) => c.isList)
			.map((col) => {
				const labels = new Set<string>();
				papers.forEach((p) => {
					const value = getValue(p, col.path);
					if (Array.isArray(value)) value.forEach((v) => labels.add(String(v)));
				});
				const color = labelColor(col.group);
				const bg = labelBg(col.group);
				const active = labelFilters.get(col.key) ?? new Set<string>();
				return `
					<div class="filter-panel__group">
						<div class="filter-panel__group-title">${escapeHtml(col.label)}</div>
						<div class="filter-panel__group-values">
							${Array.from(labels)
								.sort()
								.map(
									(label) => `
										<button class="filter-panel__value ${active.has(label) ? 'filter-panel__value--active' : ''}"
											style="--label-color:${color};--label-bg:${bg}"
											data-panel-value="${col.key}" data-label="${label}">
											<span class="filter-panel__check">${active.has(label) ? '✓' : ''}</span>
											${escapeHtml(humanizeLabel(label))}
										</button>
									`
								)
								.join('')}
						</div>
					</div>
				`;
			})
			.join('');
		filterPanelBody.innerHTML = sections;
		filterPanelBody.querySelectorAll<HTMLElement>('[data-panel-value]').forEach((btn) => {
			btn.addEventListener('click', () => {
				toggleLabelFilter(btn.dataset.panelValue ?? '', btn.dataset.label ?? '');
			});
		});
	}

	function toggleFilterPanel() {
		if (!filterPanel) return;
		const open = filterPanel.hidden;
		filterPanel.hidden = !open;
		filterToggle?.setAttribute('aria-expanded', String(!open));
		if (open) buildFilterPanel();
	}

	filterToggle?.addEventListener('click', toggleFilterPanel);
	document.querySelector<HTMLElement>('[data-clear-filters]')?.addEventListener('click', clearLabelFilters);

	// ---- Row filtering (search + label filters) ----
	function applyRowFilter() {
		const term = searchTerm.toLowerCase();
		let visible = 0;
		const activeWrap = document.querySelector<HTMLElement>(`[data-table-wrap="${activeTable}"]`);
		const rows = activeWrap ? activeWrap.querySelectorAll<HTMLElement>('[data-paper-row]') : [];
		rows.forEach((row) => {
			const id = row.dataset.paperId ?? '';
			const paper = papers.find((p) => p.id === id);
			let show = true;
			if (term) {
				show = (row.textContent ?? '').toLowerCase().includes(term);
			}
			if (show && paper) {
				for (const [col, labels] of labelFilters) {
					const value = getValue(paper, COLUMNS.find((c) => c.key === col)?.path ?? '');
					const vals = Array.isArray(value) ? value.map(String) : [String(value)];
					if (!Array.from(labels).some((l) => vals.includes(l))) {
						show = false;
						break;
					}
				}
			}
			if (show) {
				row.classList.remove('row--hidden');
				row.style.display = '';
			} else {
				row.classList.add('row--hidden');
				row.style.display = 'none';
			}
			if (show) visible++;
		});
		if (resultCount) {
			resultCount.textContent = `${visible} of ${papers.length} items`;
		}
		// Echo the count near the tabs so it stays visible while scrolling.
		const tabCount = document.querySelector<HTMLElement>('[data-tab-count]');
		if (tabCount) {
			tabCount.textContent = `${visible} paper${visible === 1 ? '' : 's'}`;
			tabCount.classList.toggle('explorer__tab-count--filtered', visible !== papers.length);
		}
		// Empty state: show when the active table has no visible rows.
		const empty = document.querySelector<HTMLElement>(`[data-table-wrap="${activeTable}"] [data-table-empty]`);
		if (empty) empty.hidden = visible > 0;
	}

	searchInput?.addEventListener('input', (e) => {
		searchTerm = (e.target as HTMLInputElement).value;
		applyRowFilter();
		writeUrlState();
	});

	// Empty-state reset button: clears search + all filters at once.
	document.querySelectorAll<HTMLElement>('[data-empty-reset]').forEach((btn) => {
		btn.addEventListener('click', () => {
			searchTerm = '';
			if (searchInput) searchInput.value = '';
			clearLabelFilters();
		});
	});

	// Clicking a label in a cell filters by it.
	document.querySelectorAll<HTMLElement>('[data-filter-label]').forEach((btn) => {
		btn.addEventListener('click', () => {
			toggleLabelFilter(btn.dataset.col ?? '', btn.dataset.label ?? '');
		});
	});

	// ---- Sorting (applies to the active table) ----
	function applySort() {
		const wrap = document.querySelector<HTMLElement>(`[data-table-wrap="${activeTable}"]`);
		const tbody = wrap?.querySelector('tbody');
		if (!tbody) return;
		const rows = Array.from(tbody.querySelectorAll<HTMLElement>('[data-paper-row]'));
		rows.sort((a, b) => {
			const pa = papers.find((p) => p.id === a.dataset.paperId);
			const pb = papers.find((p) => p.id === b.dataset.paperId);
			let va = sortCol === 'id' ? (pa?.id ?? '') : (pa?.title ?? '');
			let vb = sortCol === 'id' ? (pb?.id ?? '') : (pb?.title ?? '');
			const na = Number(va);
			const nb = Number(vb);
			let cmp: number;
			if (!isNaN(na) && !isNaN(nb)) {
				cmp = na - nb;
			} else {
				cmp = va.localeCompare(vb);
			}
			return sortDir === 'asc' ? cmp : -cmp;
		});
		rows.forEach((row) => tbody.appendChild(row));
		// Renumber the visible ID column 1..N in the new order (display-only;
		// data-paper-id keeps the real ID for filters and the profile popup).
		rows.forEach((row, i) => {
			const idBtn = row.querySelector('td button');
			if (idBtn) idBtn.textContent = String(i + 1);
		});
		document.querySelectorAll<HTMLElement>('[data-sort-arrow]').forEach((arrow) => {
			const col = arrow.dataset.sortArrow;
			if (col === sortCol) {
				arrow.textContent = sortDir === 'asc' ? '▲' : '▼';
			} else {
				arrow.textContent = '';
			}
		});
	}

	document.querySelectorAll<HTMLElement>('[data-sort-col]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const col = btn.dataset.sortCol ?? 'id';
			if (col === sortCol) {
				sortDir = sortDir === 'asc' ? 'desc' : 'asc';
			} else {
				sortCol = col;
				sortDir = 'asc';
			}
			applySort();
		});
	});

	// ---- Column header filter dropdown ----
	function openFilterMenu(colKey: string, anchor: HTMLElement) {
		if (!filterMenu) return;
		const colDef = COLUMNS.find((c) => c.key === colKey);
		if (!colDef) return;
		const labels = new Set<string>();
		papers.forEach((p) => {
			const value = getValue(p, colDef.path);
			if (Array.isArray(value)) value.forEach((v) => labels.add(String(v)));
		});
		const color = labelColor(colDef.group);
		const bg = labelBg(colDef.group);
		const active = labelFilters.get(colKey) ?? new Set<string>();
		filterMenu.innerHTML = `
			<div class="filter-menu__title">${escapeHtml(colDef.label)}</div>
			<div class="filter-menu__list">
				${Array.from(labels)
					.sort()
					.map(
						(label) => `
							<button class="filter-menu__item ${active.has(label) ? 'filter-menu__item--active' : ''}"
								style="--label-color:${color};--label-bg:${bg}"
								data-menu-label="${colKey}" data-label="${label}">
								<span class="filter-menu__check">${active.has(label) ? '✓' : ''}</span>
								${escapeHtml(humanizeLabel(label))}
							</button>
						`
					)
					.join('')}
			</div>
		`;
		filterMenu.hidden = false;
		const rect = anchor.getBoundingClientRect();
		filterMenu.style.top = `${rect.bottom + 4}px`;
		filterMenu.style.left = `${Math.min(rect.left, window.innerWidth - 260)}px`;
		filterMenu.querySelectorAll<HTMLElement>('[data-menu-label]').forEach((item) => {
			item.addEventListener('click', () => {
				toggleLabelFilter(item.dataset.menuLabel ?? '', item.dataset.label ?? '');
				openFilterMenu(colKey, anchor);
			});
		});
	}

	function closeFilterMenu() {
		if (filterMenu) filterMenu.hidden = true;
	}

	document.querySelectorAll<HTMLElement>('[data-col-filter]').forEach((btn) => {
		btn.addEventListener('click', (e) => {
			e.stopPropagation();
			const col = btn.dataset.colFilter ?? '';
			if (filterMenu && !filterMenu.hidden && filterMenu.dataset.col === col) {
				closeFilterMenu();
			} else {
				if (filterMenu) filterMenu.dataset.col = col;
				openFilterMenu(col, btn);
			}
		});
	});

	document.addEventListener('click', (e) => {
		if (filterMenu && !filterMenu.hidden && !filterMenu.contains(e.target as Node)) {
			closeFilterMenu();
		}
	});

	// ---- Paper profile popup ----
	let currentPaperId: string | null = null;
	let lastFocused: HTMLElement | null = null;

	/** Shorten long text for the prev/next navigation buttons. */
	function truncate(s: string, n: number): string {
		return s.length > n ? `${s.slice(0, n - 1)}…` : s;
	}

	/** Category page path for a column group (for cross-links to the taxonomy). */
	const GROUP_PAGE: Record<string, string> = {
		ml_task: '/ml-tasks',
		xuq_method: '/xuq-methods',
		xuq_evaluation: '/xuq-evaluation',
	};

	/** Slugify a value like the category pages do for their anchors. */
	function slugify(s: string): string {
		return s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
	}

	function openProfile(id: string) {
		const paper = papers.find((p) => p.id === id);
		if (!paper || !profileBody) return;
		currentPaperId = id;
		lastFocused = document.activeElement as HTMLElement | null;
		profileBody.innerHTML = renderProfile(paper);
		profileBody.scrollTop = 0;
		// Wire the prev/next paper buttons of the freshly rendered profile.
		profileBody.querySelectorAll<HTMLButtonElement>('[data-profile-step]').forEach((btn) => {
			btn.addEventListener('click', () => stepProfile(Number(btn.dataset.profileStep)));
		});
		if (profile) {
			profile.hidden = false;
			profile.querySelector<HTMLButtonElement>('.profile__close')?.focus();
		}
		document.body.style.overflow = 'hidden';
	}

	function closeProfile() {
		if (profile) profile.hidden = true;
		document.body.style.overflow = '';
		currentPaperId = null;
		// Return focus to the trigger for keyboard users.
		lastFocused?.focus();
		lastFocused = null;
	}

	// Focus trap: keep Tab cycling inside the open dialog.
	const FOCUSABLE = 'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])';
	profile?.addEventListener('keydown', (e) => {
		if (e.key !== 'Tab' || profile.hidden) return;
		const focusable = Array.from(profile.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
			(el) => el.offsetParent !== null,
		);
		if (focusable.length === 0) return;
		const first = focusable[0];
		const last = focusable[focusable.length - 1];
		const active = document.activeElement;
		if (e.shiftKey && (active === first || !profile.contains(active as Node))) {
			e.preventDefault();
			last.focus();
		} else if (!e.shiftKey && active === last) {
			e.preventDefault();
			first.focus();
		}
	});

	/** Open the previous (-1) or next (+1) paper in the review order. */
	function stepProfile(delta: number) {
		if (currentPaperId === null) return;
		const idx = papers.findIndex((p) => p.id === currentPaperId);
		const next = papers[(idx + delta + papers.length) % papers.length];
		if (next) openProfile(next.id);
	}

	function renderProfile(paper: Paper): string {
		// --- Hero: identity + DOI as plain text (no external links, no buttons) ---
		const doiLine = paper.doi ? `<p class="profile__doi">DOI: ${escapeHtml(paper.doi)}</p>` : '';

		// --- Abstract ---
		const abstract = paper.abstract
			? `
				<section class="profile__abstract">
					<h3 class="profile__abstract-title">Abstract</h3>
					<p>${escapeHtml(paper.abstract)}</p>
				</section>
			`
			: '';

		// --- Category sections: one grid of dimension cards per column group ---
		// The 'general' group is skipped: its fields (id, title, authors, year,
		// venue, doi) are already presented in the hero header above.
		const sectionHtml = GROUPS.filter((g) => g.id !== 'general').map((g) => {
			const groupCols = COLUMNS.filter((c) => c.group === g.id);
			const cards = groupCols
				.map((col) => {
					const value = getValue(paper, col.path);
					const vals = Array.isArray(value) ? value.map(String) : value ? [String(value)] : [];
					if (vals.length === 0) return '';
					const color = labelColor(col.group);
					const bg = labelBg(col.group);
					// Each value links to its explanation on the category page.
					const page = GROUP_PAGE[col.group];
					const tags = vals
						.map((v) => {
							const href = page ? `${page}#dim-${col.key}-${slugify(v)}` : null;
							return href
								? `<a class="profile__tag profile__tag--link" style="--label-color:${color};--label-bg:${bg}" href="${href}" title="Explain this category">${escapeHtml(humanizeLabel(v))}</a>`
								: `<span class="profile__tag" style="--label-color:${color};--label-bg:${bg}">${escapeHtml(humanizeLabel(v))}</span>`;
						})
						.join('');
					return `
						<div class="pcard" style="--g-color:${color};--g-bg:${bg}">
							<span class="pcard__label">${escapeHtml(col.label)}</span>
							<div class="pcard__values">${tags}</div>
						</div>
					`;
				})
				.join('');
			if (!cards) return '';
			const filled = groupCols.filter((c) => {
				const value = getValue(paper, c.path);
				const vals = Array.isArray(value) ? value : value ? [value] : [];
				return vals.length > 0;
			}).length;
			return `
				<section class="profile__section" style="--g-color:${g.color};--g-bg:${g.bg}">
					<h3 class="profile__section-title">
						<span class="profile__section-swatch" aria-hidden="true"></span>
						${escapeHtml(g.label)}
						<span class="profile__section-count">${filled} of ${groupCols.length} dimensions</span>
					</h3>
					<div class="profile__cards">${cards}</div>
				</section>
			`;
		}).join('');

		// --- Prev / next paper navigation ---
		const idx = papers.findIndex((p) => p.id === paper.id);
		const prev = papers[(idx - 1 + papers.length) % papers.length];
		const next = papers[(idx + 1) % papers.length];
		const nav = `
			<nav class="profile__nav" aria-label="Other papers">
				<button class="profile__nav-btn" type="button" data-profile-step="-1" aria-label="Previous paper">
					<span aria-hidden="true">←</span>
					<span class="profile__nav-title">${escapeHtml(truncate(prev.title || `Paper ${prev.id}`, 42))}</span>
				</button>
				<button class="profile__nav-btn profile__nav-btn--next" type="button" data-profile-step="1" aria-label="Next paper">
					<span aria-hidden="true">→</span>
					<span class="profile__nav-title">${escapeHtml(truncate(next.title || `Paper ${next.id}`, 42))}</span>
				</button>
			</nav>
		`;

		return `
			<header class="profile__hero">
				<div class="profile__chips">
					<span class="profile__chip profile__chip--id">Paper #${escapeHtml(paper.id)}</span>
					${paper.year ? `<span class="profile__chip">${paper.year}</span>` : ''}
				</div>
				<h2 class="profile__title" id="profile-title">${escapeHtml(paper.title || `Paper ${paper.id}`)}</h2>
				${paper.authors.length ? `<p class="profile__meta">${escapeHtml(paper.authors.join(', '))}</p>` : ''}
				${paper.venue ? `<p class="profile__venue">${escapeHtml(paper.venue)}</p>` : ''}
				${doiLine}
			</header>
			${abstract}
			${sectionHtml}
			${nav}
		`;
	}

	function humanizeLabel(s: string): string {
		return valueLabel(s) !== s ? valueLabel(s) : s.replace(/_/g, ' ').replace(/\s+/g, ' ').trim();
	}

	function escapeHtml(s: string): string {
		return s.replace(/[&<>"']/g, (c) => {
			const map: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
			return map[c];
		});
	}

	// Delegate clicks on paper links.
	document.querySelectorAll<HTMLElement>('[data-open-profile]').forEach((btn) => {
		btn.addEventListener('click', () => openProfile(btn.dataset.paperId ?? ''));
	});
	document.querySelectorAll<HTMLElement>('[data-profile-close]').forEach((el) => {
		el.addEventListener('click', closeProfile);
	});
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') {
			closeProfile();
			closeFilterMenu();
			if (filterPanel && !filterPanel.hidden) toggleFilterPanel();
		}
	});

	// Initial state: read tab/search/filters from the URL, then render.
	readUrlState();
	switchTable(activeTable);
	renderActiveFilters();
	renderFilterBadge();
	applySort();

	// Deep link: /paper-explorer?paper=<id> opens that paper's profile
	// (used by the category pages' paper lists). Consumed once, then removed
	// from the URL so refresh/back behave naturally.
	const deepLinkPaper = new URLSearchParams(window.location.search).get('paper');
	if (deepLinkPaper && papers.some((p) => p.id === deepLinkPaper)) {
		openProfile(deepLinkPaper);
		const params = new URLSearchParams(window.location.search);
		params.delete('paper');
		const qs = params.toString();
		window.history.replaceState(null, '', qs ? `?${qs}` : window.location.pathname);
	}
</script>

