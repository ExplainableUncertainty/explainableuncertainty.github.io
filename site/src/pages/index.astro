---
// index.astro — landing page: paper intro, XUQ definition, scheme figure, methodology, nav buttons.
import BaseLayout from '../layouts/BaseLayout.astro';
import papers from '../data/papers.json';
// Interactive Figure 1 scheme is currently replaced by a static image (see below).
// import FigureOne from '../components/FigureOne.astro';

const paperCount = papers.length;
---

<BaseLayout
	title="Explainable Uncertainty Quantification"
	description="Companion site to the systematic literature review on Explainable Uncertainty Quantification (XUQ)."
	currentPath="/"
>
	<article class="landing">
		<!-- Paper title -->
		<header class="landing__header">
			<p class="landing__kicker">A Systematic Literature Review, Novel Definition, and Future Directions</p>
			<h1 class="landing__title">
				Explainable Uncertainty Quantification
			</h1>
		</header>

		<!-- Definition -->
		<section class="landing__section" id="definition">
			<h2>What is Explainable Uncertainty Quantification?</h2>
			<blockquote class="landing__definition">
				<p>
					<strong>Explainable Uncertainty Quantification (XUQ)</strong> contains all the mechanisms that make an
					estimate of uncertainty of AI-based models more understandable to humans.
				</p>
			</blockquote>
			<p>
				While conventional Explainable AI (XAI) explains <em>what</em> was predicted, and Uncertainty-Aware XAI
				quantifies <em>how (un)certain an explanation is</em>, XUQ instead asks <em>why a given uncertainty
				estimate takes the value it does</em>. Its target of analysis is the model’s uncertainty estimate — for
				example a predictive variance or a prediction-interval width — rather than the prediction itself.
			</p>
		</section>

		<!-- Figure 1 -->
		<section class="landing__section" id="figure">
			<!-- Static scheme image (public/scheme.png). The interactive scheme can be
			     restored by uncommenting the import above and the component below. -->
			<figure class="landing__scheme">
				<img
					src="/XUQ_Overview.svg"
					alt="Overview of XUQ: definition, motivation with stakeholders (clinician, patient, AI researcher), current state, and research gaps and future directions across scope, methods, and evaluation"
				/>
				<figcaption class="landing__scheme-caption">
					Overview of XUQ: Definition, motivation, current state, and future research directions. The overview
					illustrates the motivation for XUQ through a clinical prediction scenario and different
					stakeholder-specific needs. Based on the results from the structured literature review, it summarizes
					the current state of the field across scope, methods, and evaluation of XUQ. In addition, it
					highlights the identified research gaps and directions for future research.
				</figcaption>
			</figure>
			<!-- <FigureOne /> -->
		</section>

		<!-- Methodology -->
		<section class="landing__section" id="methodology">
			<h2>How the review was conducted</h2>
			<p>
				We performed a systematic literature review based on the PRISMA guidelines{' '}
				<a class="landing__ref-link" href="#references-prisma">[1]</a>. We identified{' '}
				<strong>{paperCount} relevant publications</strong> on XUQ. Based on these publications, we answer the following
				four research questions:
			</p>
			<ul class="landing__rq">
				<li><strong>RQ1:</strong> What is the current scope of research on XUQ?</li>
				<li><strong>RQ2:</strong> Which types of explanations of uncertainty are proposed and applied in the literature?</li>
				<li><strong>RQ3:</strong> How are explanations of uncertainty evaluated in the literature?</li>
				<li><strong>RQ4:</strong> What research gaps and future research directions are identified in the XUQ literature?</li>
			</ul>
			<p>
				To answer the research questions, we structured all papers according to different categories spanning
				the overall research context, XUQ method, and evaluation of XUQ. More details on the categories
				can be found in the <a href="/category-explorer">category explorer</a> and in the paper.
			</p>
		</section>

		<!-- Navigation buttons -->
		<section class="landing__section landing__nav" id="explore">
			<h2>Explore the data</h2>
			<p>
				Explore the {paperCount} reviewed studies through two complementary views: browse papers across different
				categories and dimensions or search individual papers.
			</p>
			<div class="landing__buttons">
				<a class="btn btn--primary" href="/category-explorer">
					<span class="btn__label">Category Explorer</span>
					<span class="btn__hint">Explore the different dimensions and categories used in the review. Discover which papers fall into specific categories.</span>
				</a>
				<a class="btn btn--primary" href="/paper-explorer">
					<span class="btn__label">Paper Explorer</span>
					<span class="btn__hint">Search and browse the complete collection of reviewed papers.</span>
				</a>
			</div>
		</section>

		<!-- Reference cited in the methodology ([1] PRISMA). -->
		<div class="landing__reference" id="references-prisma">
			<p class="landing__reference-text">
				[1] Page, M. J., McKenzie, J. E., Bossuyt, P. M., Boutron, I., Hoffmann, T. C., Mulrow, C. D.,
				Shamseer, L., Tetzlaff, J. M., Akl, E. A., Brennan, S. E., et al. (2021). The PRISMA 2020
				statement: an updated guideline for reporting systematic reviews. <em>BMJ</em>, 372, n71.
			</p>
		</div>
	</article>
</BaseLayout>

<script>
	// The [1] marker targets #references-prisma on this page. Smooth scrolling gets
	// cancelled by layout shifts (image loading), so scroll instantly on click, and
	// re-anchor after load when arriving with the hash set.
	const scrollToRef = () => {
		document.getElementById('references-prisma')?.scrollIntoView({ behavior: 'auto', block: 'start' });
	};

	document.querySelector<HTMLAnchorElement>('.landing__ref-link')?.addEventListener('click', (e) => {
		e.preventDefault();
		scrollToRef();
		history.replaceState(null, '', '#references-prisma');
	});

	if (window.location.hash === '#references-prisma') {
		scrollToRef();
		window.addEventListener('load', scrollToRef, { once: true });
	}
</script>

<style>
	.landing__header {
		margin-bottom: var(--space-8);
		padding-bottom: var(--space-6);
		border-bottom: 1px solid var(--color-border);
	}

	.landing__kicker {
		margin: 0 0 var(--space-2);
		font-size: var(--text-sm);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-teal-600);
	}

	.landing__title {
		margin: 0 0 var(--space-3);
		font-size: var(--text-5xl);
		line-height: 1.1;
		color: var(--color-navy-800);
	}

	.landing__section {
		margin-bottom: var(--space-8);
	}

	.landing__definition {
		margin: 0 0 var(--space-4);
		padding: var(--space-5) var(--space-6);
		border-left: 4px solid var(--color-teal-500);
		border-radius: 0 var(--radius-md) var(--radius-md) 0;
		background: var(--color-teal-50);
		font-size: var(--text-xl);
		line-height: 1.5;
		color: var(--color-navy-800);
	}
	.landing__definition p {
		margin: 0;
	}

	.landing__nav {
		padding: var(--space-6);
		border-radius: var(--radius-lg);
		background: var(--color-bg-alt);
		border: 1px solid var(--color-border);
	}

	/* Static scheme image — displayed bare (no frame/box behind it). */
	.landing__scheme {
		margin: 0;
	}
	.landing__scheme img {
		display: block;
		width: 100%;
		height: auto;
	}
	.landing__scheme-caption {
		margin-top: var(--space-3);
		font-size: var(--text-sm);
		line-height: 1.6;
		color: var(--color-text-muted);
	}

	/* Research questions list in the methodology section */
	.landing__rq {
		margin: 0 0 var(--space-4);
		padding-left: var(--space-6);
		display: grid;
		gap: var(--space-1);
		font-size: var(--text-base);
		color: var(--color-text);
	}

	/* Clickable [1] reference marker → PRISMA reference on the category explorer */
	.landing__ref-link {
		font-weight: 700;
		color: var(--color-teal-700);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.landing__ref-link:hover {
		color: var(--color-teal-500);
	}

	/* PRISMA reference block ([1]), at the bottom of the page */
	.landing__reference {
		margin-top: var(--space-8);
		padding: var(--space-4) var(--space-5);
		border: 1px solid var(--color-border);
		border-left: 4px solid var(--color-teal-500);
		border-radius: var(--radius-md);
		background: var(--color-bg-alt);
		scroll-margin-top: calc(var(--header-height) + var(--space-4));
	}
	.landing__reference-text {
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.6;
		color: var(--color-text);
	}

	.landing__buttons {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		margin-top: var(--space-4);
	}

	.btn {
		display: inline-flex;
		flex-direction: column;
		/* Equal-width buttons: both grow to fill the row equally. */
		flex: 1 1 16rem;
		gap: var(--space-1);
		padding: var(--space-4) var(--space-6);
		border-radius: var(--radius-md);
		font-weight: 600;
		text-decoration: none;
		transition: transform var(--transition-fast), box-shadow var(--transition-fast);
	}
	.btn:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
	}
	.btn__label {
		font-size: var(--text-lg);
	}
	.btn__hint {
		font-size: var(--text-sm);
		font-weight: 400;
		opacity: 0.85;
	}

	.btn--primary {
		background: var(--gradient-header);
		color: var(--color-text-inverse);
	}
	.btn--primary:hover {
		color: var(--color-text-inverse);
	}

	.btn--secondary {
		background: var(--color-surface);
		color: var(--color-teal-700);
		border: 1px solid var(--color-teal-300);
	}
	.btn--secondary:hover {
		color: var(--color-teal-800);
	}

	@media (max-width: 48rem) {
		.landing__title {
			font-size: var(--text-4xl);
		}
		.landing__buttons {
			flex-direction: column;
		}
		.btn {
			width: 100%;
		}
	}
</style>
