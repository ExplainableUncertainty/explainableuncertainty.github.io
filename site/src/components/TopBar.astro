---
// TopBar.astro — fixed top bar: hamburger toggle + wordmark linking home.
// The open state is managed by the BaseLayout script via the `sidebar-open`
// class on <body>; the hamburger's aria-expanded is updated there too.
---

<header class="topbar">
	<div class="topbar__inner">
		<button
			class="topbar__hamburger"
			type="button"
			aria-label="Toggle navigation menu"
			aria-expanded="false"
			aria-controls="side-menu"
			data-menu-toggle
		>
			<span class="topbar__hamburger-bar"></span>
			<span class="topbar__hamburger-bar"></span>
			<span class="topbar__hamburger-bar"></span>
		</button>

		<a class="topbar__wordmark" href="/" aria-label="XUQ Explorer — home">
			<span class="topbar__wordmark-accent">XUQ</span> Explorer
		</a>
	</div>
</header>

<style>
	.topbar {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 50;
		height: var(--header-height);
		background: var(--gradient-header);
		color: var(--color-text-inverse);
		box-shadow: var(--shadow-md);
	}

	.topbar__inner {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		height: 100%;
		padding-inline: var(--space-4);
	}

	.topbar__hamburger {
		display: inline-flex;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 2.5rem;
		height: 2.5rem;
		padding: var(--space-2);
		border: none;
		border-radius: var(--radius-sm);
		background: transparent;
		cursor: pointer;
	}
	.topbar__hamburger:hover {
		background: rgba(255, 255, 255, 0.12);
	}
	.topbar__hamburger-bar {
		display: block;
		width: 100%;
		height: 2px;
		border-radius: 2px;
		background: var(--color-text-inverse);
		transition: transform var(--transition-base), opacity var(--transition-base);
	}
	.topbar__hamburger[aria-expanded='true'] .topbar__hamburger-bar:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}
	.topbar__hamburger[aria-expanded='true'] .topbar__hamburger-bar:nth-child(2) {
		opacity: 0;
	}
	.topbar__hamburger[aria-expanded='true'] .topbar__hamburger-bar:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	.topbar__wordmark {
		font-size: var(--text-lg);
		font-weight: 700;
		letter-spacing: 0.02em;
		color: var(--color-text-inverse);
	}
	.topbar__wordmark:hover {
		color: var(--color-teal-200);
	}
	.topbar__wordmark-accent {
		color: var(--color-teal-300);
	}
</style>