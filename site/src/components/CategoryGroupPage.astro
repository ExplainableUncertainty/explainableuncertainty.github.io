---
// CategoryGroupPage.astro — shared layout for a category explorer subpage.
// Renders the intro, overview table, and dimension sections for one group.
import BaseLayout from '../layouts/BaseLayout.astro';
import papers from '../data/papers.json';
import '../styles/profile-popup.css';
import categories from '../data/categories.json';
import { papersForValue, humanizeLabel, displayLabel, getCategoryGroup } from '../data/categoryTypes';
import type { CategoryDimension } from '../data/categoryTypes';
import type { Paper } from '../data/paperTypes';
import type { ColumnGroup } from '../data/paperTypes';

interface Props {
	/** The group to display (ml_task | xuq_method | xuq_evaluation). */
	group: ColumnGroup;
	/** Page title. */
	title: string;
	/** Current path for nav highlighting. */
	currentPath: string;
}

const { group, title, currentPath } = Astro.props;
const groupDef = getCategoryGroup(group);
const dims = categories.dimensions.filter((d) => d.group === group);

// Precompute paper references for every dimension value.
const refsByDim: Record<string, Record<string, ReturnType<typeof papersForValue>>> = {};
dims.forEach((dim: CategoryDimension) => {
	refsByDim[dim.id] = {};
	dim.values.forEach((v) => {
		refsByDim[dim.id][v.value] = papersForValue(papers as Paper[], dim.id, v.value);
	});
});

// Slugify a value for use in anchor ids.
function slugify(s: string): string {
	return s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
}

// Order values by number of papers (descending).
function orderedValues(dim: CategoryDimension) {
	return [...dim.values].sort((a, b) => {
		const na = refsByDim[dim.id][a.value]?.length ?? 0;
		const nb = refsByDim[dim.id][b.value]?.length ?? 0;
		return nb - na;
	});
}
---

<BaseLayout title={title} description={groupDef.description} currentPath={currentPath}>
	<article class="categories">
		<header class="categories__header">
			<h1>{title}</h1>
			<p>
				{
					group === 'ml_task' ? (
						<>The general properties of the machine learning (ML) task of the reviewed studies. This covers whether a study is method- or application-oriented, the application domain it targets, the data modality and ML task it addresses, and the intended target audience of the explanations.</>
					) : group === 'xuq_evaluation' ? (
						<>Browse how the reviewed studies evaluated their explanations of uncertainty. This covers whether the explanations were evaluated in the first place, the type of evaluation performed (functionally-grounded, human-grounded, application-grounded, or anecdotal evidence), the Co-12 properties{' '}<a class="ref-link" href="#references">[1]</a> addressed, and whether the applied XUQ method was benchmarked against other methods</>
					) : (
						groupDef.description
					)
				}
			</p>
		</header>

		<!-- Overview table: one row per dimension -->
		<section class="categories__overview" id="overview">
			<h2>Overview</h2>
			<div class="overview__table-wrap">
				<table class="overview__table">
					<thead>
						<tr>
							<th scope="col">Dimension</th>
							<th scope="col">Categories</th>
						</tr>
					</thead>
					<tbody>
						{
							dims.map((dim: CategoryDimension) => (
								<tr>
									<td class="overview__dim">
										<a href={`#dim-${dim.id}`} class="overview__dim-link" style={`--dim-color:${groupDef.color}`}>
											{dim.label}
										</a>
									</td>
									<td class="overview__values">
										{
											orderedValues(dim).map((v) => (
												<a
													href={`#dim-${dim.id}-${slugify(v.value)}`}
													class="overview__label"
													style={`--label-color:${groupDef.color};--label-bg:${groupDef.bg}`}
												>
													{displayLabel(v)}
												</a>
											))
										}
									</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</section>

		<!-- One section per dimension -->
		{
			dims.map((dim: CategoryDimension) => (
				<section class="dimension" id={`dim-${dim.id}`}>
					<a class="dimension__top" href="#overview" aria-label="Back to overview">↑ Overview</a>
					<h2 class="dimension__title" style={`--dim-color:${groupDef.color}`}>{dim.label}</h2>
					<p class="dimension__desc">{dim.description}</p>

					<div class="dimension__values">
						{
							orderedValues(dim).map((v) => {
								const refs = refsByDim[dim.id][v.value];
								return (
									<div class="value-block" id={`dim-${dim.id}-${slugify(v.value)}`}>
										<div class="value-block__head">
											<div class="value-block__info">
												<span class="value-block__name" style={`--label-color:${groupDef.color};--label-bg:${groupDef.bg}`}>
													{displayLabel(v)}
												</span>
												<span class="value-block__summary">{v.summary}</span>
											</div>
											<button
												class="value-block__toggle"
												type="button"
												aria-expanded="false"
												aria-controls={`refs-${dim.id}-${slugify(v.value)}`}
												data-ref-toggle
											>
												<span class="value-block__count">{refs.length} papers</span>
												<span class="value-block__arrow" aria-hidden="true">▸</span>
											</button>
										</div>
										<div
											class="value-block__refs"
											id={`refs-${dim.id}-${slugify(v.value)}`}
											hidden
										>
											<ul class="value-block__ref-list">
												{
													refs.map((ref) => (
														<li class="value-block__ref">
															<button
																class="value-block__ref-title"
																type="button"
																data-open-paper={ref.id}
																title="Open paper profile"
															>
																{ref.title || `Paper ${ref.id}`}
															</button>
															<span class="value-block__ref-meta">
																{ref.authors.length ? ref.authors.join(', ') : ''}
																{ref.year ? ` · ${ref.year}` : ''}
																{ref.venue ? ` · ${ref.venue}` : ''}
															</span>
														</li>
													))
												}
											</ul>
										</div>
									</div>
								);
							})
						}
					</div>
				</section>
			))
		}

		{
			group === 'xuq_evaluation' && (
				<div class="categories__reference" id="references">
					<p class="categories__reference-title">Reference</p>
					<p class="categories__reference-text">
						[1] Nauta, M., Trienes, J., Pathak, S., Nguyen, E., Peters, M., Schmitt, Y., Schlötterer, J.,
						van Keulen, M., &amp; Seifert, C. (2023). From Anecdotal Evidence to Quantitative Evaluation
						Methods: A Systematic Review on Evaluating Explainable AI. <em>ACM Computing Surveys</em>,
						55(13s), 1–42.
					</p>
				</div>
			)
		}
	</article>

	<!-- Paper profile popup: opens in place, no redirect to the Paper Explorer. -->
	<div class="profile" data-profile hidden>
		<div class="profile__backdrop" data-profile-close></div>
		<div class="profile__dialog" role="dialog" aria-modal="true" aria-labelledby="profile-title">
			<div class="profile__bar">
				<span class="profile__bar-label">Paper profile</span>
				<button class="profile__close" type="button" data-profile-close aria-label="Close paper profile">
					<svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
						<path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
					</svg>
				</button>
			</div>
			<div class="profile__body" data-profile-body></div>
		</div>
	</div>
</BaseLayout>

<script>
	import papers from '../data/papers.json';
	import { COLUMNS, GROUPS, getValue, labelColor, labelBg } from '../data/paperTypes';
	import { displayValueLabel } from '../data/categoryTypes';
	import type { Paper } from '../data/paperTypes';

	// Collapsible paper references.
	document.querySelectorAll<HTMLElement>('[data-ref-toggle]').forEach((btn) => {		btn.addEventListener('click', () => {
			const targetId = btn.getAttribute('aria-controls');
			const target = document.getElementById(targetId ?? '');
			if (!target) return;
			const open = target.hidden;
			target.hidden = !open;
			btn.setAttribute('aria-expanded', String(open));
			const arrow = btn.querySelector('.value-block__arrow');
			if (arrow) arrow.textContent = open ? '▾' : '▸';
		});
	});

	// ---- In-place paper profile popup (same design as the Paper Explorer's) ----
	const profile = document.querySelector<HTMLElement>('[data-profile]');
	const profileBody = document.querySelector<HTMLElement>('[data-profile-body]');
	let currentPaperId: string | null = null;
	let lastFocused: HTMLElement | null = null;

	function escapeHtml(s: string): string {
		return s.replace(/[&<>"']/g, (c) => {
			const map: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
			return map[c];
		});
	}

	function humanizeLabel(s: string): string {
		return s.replace(/_/g, ' ').replace(/\s+/g, ' ').trim();
	}

	function truncate(s: string, n: number): string {
		return s.length > n ? `${s.slice(0, n - 1)}…` : s;
	}

	/** Category page path for a column group (cross-links to the taxonomy). */
	const GROUP_PAGE: Record<string, string> = {
		ml_task: '/ml-tasks',
		xuq_method: '/xuq-methods',
		xuq_evaluation: '/xuq-evaluation',
	};

	function slugify(s: string): string {
		return s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
	}

	function renderProfile(paper: Paper): string {
		// DOI as plain text (no external links, no buttons).
		const doiLine = paper.doi ? `<p class="profile__doi">DOI: ${escapeHtml(paper.doi)}</p>` : '';

		const abstract = paper.abstract
			? `
				<section class="profile__abstract">
					<h3 class="profile__abstract-title">Abstract</h3>
					<p>${escapeHtml(paper.abstract)}</p>
				</section>
			`
			: '';

		// Dimension cards per group ('general' is covered by the hero header).
		const sectionHtml = GROUPS.filter((g) => g.id !== 'general').map((g) => {
			const groupCols = COLUMNS.filter((c) => c.group === g.id);
			const cards = groupCols
				.map((col) => {
					const value = getValue(paper, col.path);
					const vals = Array.isArray(value) ? value.map(String) : value ? [String(value)] : [];
					if (vals.length === 0) return '';
					const color = labelColor(col.group);
					const bg = labelBg(col.group);
					const page = GROUP_PAGE[col.group];
					const tags = vals
						.map((v) => {
							const href = page ? `${page}#dim-${col.key}-${slugify(v)}` : null;
							return href
								? `<a class="profile__tag profile__tag--link" style="--label-color:${color};--label-bg:${bg}" href="${href}">${escapeHtml(displayValueLabel(v))}</a>`
								: `<span class="profile__tag" style="--label-color:${color};--label-bg:${bg}">${escapeHtml(displayValueLabel(v))}</span>`;
						})
						.join('');
					return `
						<div class="pcard" style="--g-color:${color};--g-bg:${bg}">
							<span class="pcard__label">${escapeHtml(col.label)}</span>
							<div class="pcard__values">${tags}</div>
						</div>
					`;
				})
				.join('');
			if (!cards) return '';
			const filled = groupCols.filter((c) => {
				const value = getValue(paper, c.path);
				const vals = Array.isArray(value) ? value : value ? [value] : [];
				return vals.length > 0;
			}).length;
			return `
				<section class="profile__section" style="--g-color:${g.color};--g-bg:${g.bg}">
					<h3 class="profile__section-title">
						<span class="profile__section-swatch" aria-hidden="true"></span>
						${escapeHtml(g.label)}
						<span class="profile__section-count">${filled} of ${groupCols.length} dimensions</span>
					</h3>
					<div class="profile__cards">${cards}</div>
				</section>
			`;
		}).join('');

		const idx = papers.findIndex((p) => p.id === paper.id);
		const prev = papers[(idx - 1 + papers.length) % papers.length];
		const next = papers[(idx + 1) % papers.length];
		const nav = `
			<nav class="profile__nav" aria-label="Other papers">
				<button class="profile__nav-btn" type="button" data-profile-step="-1" aria-label="Previous paper">
					<span aria-hidden="true">←</span>
					<span class="profile__nav-title">${escapeHtml(truncate(prev.title || `Paper ${prev.id}`, 42))}</span>
				</button>
				<button class="profile__nav-btn profile__nav-btn--next" type="button" data-profile-step="1" aria-label="Next paper">
					<span aria-hidden="true">→</span>
					<span class="profile__nav-title">${escapeHtml(truncate(next.title || `Paper ${next.id}`, 42))}</span>
				</button>
			</nav>
		`;

		return `
			<header class="profile__hero">
				<div class="profile__chips">
					<span class="profile__chip profile__chip--id">Paper #${escapeHtml(paper.id)}</span>
					${paper.year ? `<span class="profile__chip">${paper.year}</span>` : ''}
				</div>
				<h2 class="profile__title" id="profile-title">${escapeHtml(paper.title || `Paper ${paper.id}`)}</h2>
				${paper.authors.length ? `<p class="profile__meta">${escapeHtml(paper.authors.join(', '))}</p>` : ''}
				${paper.venue ? `<p class="profile__venue">${escapeHtml(paper.venue)}</p>` : ''}
				${doiLine}
			</header>
			${abstract}
			${sectionHtml}
			${nav}
		`;
	}

	function openProfile(id: string) {
		const paper = papers.find((p) => p.id === id);
		if (!paper || !profileBody) return;
		currentPaperId = id;
		lastFocused = document.activeElement as HTMLElement | null;
		profileBody.innerHTML = renderProfile(paper);
		profileBody.scrollTop = 0;
		profileBody.querySelectorAll<HTMLButtonElement>('[data-profile-step]').forEach((btn) => {
			btn.addEventListener('click', () => stepProfile(Number(btn.dataset.profileStep)));
		});
		if (profile) {
			profile.hidden = false;
			profile.querySelector<HTMLButtonElement>('.profile__close')?.focus();
		}
		document.body.style.overflow = 'hidden';
	}

	function closeProfile() {
		if (profile) profile.hidden = true;
		document.body.style.overflow = '';
		currentPaperId = null;
		lastFocused?.focus();
		lastFocused = null;
	}

	function stepProfile(delta: number) {
		if (currentPaperId === null) return;
		const idx = papers.findIndex((p) => p.id === currentPaperId);
		const next = papers[(idx + delta + papers.length) % papers.length];
		if (next) openProfile(next.id);
	}

	// Paper titles open the profile popup in place (no redirect).
	document.querySelectorAll<HTMLElement>('[data-open-paper]').forEach((btn) => {
		btn.addEventListener('click', () => openProfile(btn.getAttribute('data-open-paper') ?? ''));
	});
	document.querySelectorAll<HTMLElement>('[data-profile-close]').forEach((el) => {
		el.addEventListener('click', closeProfile);
	});
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && profile && !profile.hidden) closeProfile();
	});

	// Reference links ([1]): scroll to the reference block. Smooth scrolling is
	// unreliable here (layout shifts cancel the animation), so scroll instantly.
	document.querySelectorAll<HTMLAnchorElement>('a.ref-link[href^="#"]').forEach((link) => {
		link.addEventListener('click', (e) => {
			const target = document.getElementById(link.getAttribute('href')?.slice(1) ?? '');
			if (target) {
				e.preventDefault();
				target.scrollIntoView({ behavior: 'auto', block: 'start' });
				history.replaceState(null, '', link.getAttribute('href') ?? '');
			}
		});
	});

	// Focus trap: keep Tab cycling inside the open dialog.
	const FOCUSABLE = 'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])';
	profile?.addEventListener('keydown', (e) => {
		if (e.key !== 'Tab' || profile.hidden) return;
		const focusable = Array.from(profile.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
			(el) => el.offsetParent !== null,
		);
		if (focusable.length === 0) return;
		const first = focusable[0];
		const last = focusable[focusable.length - 1];
		const active = document.activeElement;
		if (e.shiftKey && (active === first || !profile.contains(active as Node))) {
			e.preventDefault();
			last.focus();
		} else if (!e.shiftKey && active === last) {
			e.preventDefault();
			first.focus();
		}
	});
</script>

<style>
	.categories__header {
		margin-bottom: var(--space-6);
	}
	.categories__header p {
		max-width: 60rem;
		color: var(--color-text);
	}

	/* ---- Overview table ---- */
	.categories__overview {
		margin-bottom: var(--space-4);
		scroll-margin-top: calc(var(--header-height) + var(--space-4));
	}
	.overview__table-wrap {
		overflow-x: auto;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
	}
	.overview__table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--text-sm);
	}
	.overview__table th,
	.overview__table td {
		padding: var(--space-3);
		border-bottom: 1px solid var(--color-border);
		text-align: left;
		vertical-align: top;
	}
	.overview__table thead th {
		background: var(--color-navy-100);
		color: var(--color-navy-800);
		font-weight: 700;
	}
	.overview__table tbody tr:last-child td {
		border-bottom: none;
	}
	.overview__dim {
		white-space: nowrap;
		font-weight: 600;
	}
	.overview__dim-link {
		color: var(--dim-color);
	}
	.overview__dim-link:hover {
		text-decoration: underline;
	}
	.overview__values {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
	}
	.overview__label {
		display: inline-flex;
		align-items: center;
		padding: 2px var(--space-2);
		border: 1px solid var(--label-color);
		border-radius: 999px;
		background: var(--label-bg);
		color: var(--label-color);
		font-size: var(--text-xs);
		font-weight: 600;
		white-space: nowrap;
	}
	.overview__label:hover {
		filter: brightness(0.95);
	}

	/* ---- Dimension sections ---- */
	.dimension {
		margin-bottom: var(--space-8);
		padding-top: var(--space-2);
		/* Anchored jumps land below the fixed header + sticky dim-nav. */
		scroll-margin-top: calc(var(--header-height) + 3.5rem);
	}
	.dimension__top {
		display: inline-block;
		margin-bottom: var(--space-1);
		font-size: var(--text-xs);
		font-weight: 600;
		color: var(--color-text-muted);
		text-decoration: none;
	}
	.dimension__top:hover {
		color: var(--color-teal-700);
		text-decoration: underline;
	}
	.dimension__title {
		margin: 0 0 var(--space-2);
		color: var(--dim-color);
	}
	.dimension__desc {
		margin: 0 0 var(--space-4);
		color: var(--color-text-muted);
		max-width: 60rem;
	}
	.dimension__values {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	/* ---- Reference footer (Nauta et al. [1] / PRISMA [2]) ---- */
	.categories__reference {
		margin-top: var(--space-4);
		padding: var(--space-4) var(--space-5);
		border: 1px solid var(--color-border);
		border-left: 4px solid var(--color-teal-500);
		border-radius: var(--radius-md);
		background: var(--color-bg-alt);
		scroll-margin-top: calc(var(--header-height) + var(--space-4));
	}
	/* Clickable [1]/[2] markers in the intro text. */
	.ref-link {
		font-weight: 700;
		color: var(--color-teal-700);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.ref-link:hover {
		color: var(--color-teal-500);
	}
	.categories__reference-title {
		margin: 0 0 var(--space-1);
		font-size: var(--text-xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-teal-700);
	}
	.categories__reference-text {
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.6;
		color: var(--color-text);
	}

	/* ---- Value blocks ---- */
	.value-block {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		overflow: hidden;
	}
	.value-block__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		padding: var(--space-3) var(--space-4);
	}
	.value-block__info {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		flex-wrap: wrap;
	}
	.value-block__name {
		display: inline-flex;
		align-items: center;
		padding: 2px var(--space-3);
		border: 1px solid var(--label-color);
		border-radius: 999px;
		background: var(--label-bg);
		color: var(--label-color);
		font-size: var(--text-sm);
		font-weight: 700;
		white-space: nowrap;
	}
	.value-block__summary {
		font-weight: 600;
		color: var(--color-text);
	}
	.value-block__toggle {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		border: none;
		background: none;
		padding: var(--space-1) var(--space-2);
		border-radius: var(--radius-sm);
		cursor: pointer;
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		white-space: nowrap;
	}
	.value-block__toggle:hover {
		background: var(--color-bg-alt);
		color: var(--color-text);
	}
	.value-block__count {
		font-weight: 600;
	}
	.value-block__arrow {
		font-size: var(--text-base);
		transition: transform var(--transition-fast);
	}

	.value-block__refs {
		border-top: 1px solid var(--color-border);
		background: var(--color-bg-alt);
		padding: var(--space-3) var(--space-4);
	}
	.value-block__refs[hidden] {
		display: none;
	}
	.value-block__ref-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}
