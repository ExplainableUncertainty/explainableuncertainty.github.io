---
// CategoryGroupPage.astro — shared layout for a category explorer subpage.
// Renders the intro, overview table, and dimension sections for one group.
import BaseLayout from '../layouts/BaseLayout.astro';
import papers from '../data/papers.json';
import categories from '../data/categories.json';
import { papersForValue, humanizeLabel, getCategoryGroup } from '../data/categoryTypes';
import type { CategoryDimension } from '../data/categoryTypes';
import type { Paper } from '../data/paperTypes';
import type { ColumnGroup } from '../data/paperTypes';

interface Props {
	/** The group to display (ml_task | xuq_method | xuq_evaluation). */
	group: ColumnGroup;
	/** Page title. */
	title: string;
	/** Current path for nav highlighting. */
	currentPath: string;
}

const { group, title, currentPath } = Astro.props;
const groupDef = getCategoryGroup(group);
const dims = categories.dimensions.filter((d) => d.group === group);

// Precompute paper references for every dimension value.
const refsByDim: Record<string, Record<string, ReturnType<typeof papersForValue>>> = {};
dims.forEach((dim: CategoryDimension) => {
	refsByDim[dim.id] = {};
	dim.values.forEach((v) => {
		refsByDim[dim.id][v.value] = papersForValue(papers as Paper[], dim.id, v.value);
	});
});

// Slugify a value for use in anchor ids.
function slugify(s: string): string {
	return s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
}

// Order values by number of papers (descending).
function orderedValues(dim: CategoryDimension) {
	return [...dim.values].sort((a, b) => {
		const na = refsByDim[dim.id][a.value]?.length ?? 0;
		const nb = refsByDim[dim.id][b.value]?.length ?? 0;
		return nb - na;
	});
}
---

<BaseLayout title={title} description={groupDef.description} currentPath={currentPath}>
	<article class="categories">
		<header class="categories__header">
			<h1>{title}</h1>
			<p>{groupDef.description}</p>
		</header>

		<!-- Overview table: one row per dimension -->
		<section class="categories__overview" id="overview">
			<h2>Overview</h2>
			<div class="overview__table-wrap">
				<table class="overview__table">
					<thead>
						<tr>
							<th scope="col">Dimension</th>
							<th scope="col">Categories</th>
						</tr>
					</thead>
					<tbody>
						{
							dims.map((dim: CategoryDimension) => (
								<tr>
									<td class="overview__dim">
										<a href={`#dim-${dim.id}`} class="overview__dim-link" style={`--dim-color:${groupDef.color}`}>
											{dim.label}
										</a>
									</td>
									<td class="overview__values">
										{
											orderedValues(dim).map((v) => (
												<a
													href={`#dim-${dim.id}-${slugify(v.value)}`}
													class="overview__label"
													style={`--label-color:${groupDef.color};--label-bg:${groupDef.bg}`}
												>
													{humanizeLabel(v.value)}
												</a>
											))
										}
									</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</section>

		<!-- Sticky in-page nav: quick jumps between dimension sections while scrolling. -->
		<nav class="dim-nav" aria-label="Jump to dimension">
			{
				dims.map((dim: CategoryDimension) => (
					<a class="dim-nav__link" href={`#dim-${dim.id}`} style={`--dim-color:${groupDef.color}`}>
						{dim.label}
					</a>
				))
			}
		</nav>

		<!-- One section per dimension -->
		{
			dims.map((dim: CategoryDimension) => (
				<section class="dimension" id={`dim-${dim.id}`}>
					<a class="dimension__top" href="#overview" aria-label="Back to overview">↑ Overview</a>
					<h2 class="dimension__title" style={`--dim-color:${groupDef.color}`}>{dim.label}</h2>
					<p class="dimension__desc">{dim.description}</p>

					<div class="dimension__values">
						{
							orderedValues(dim).map((v) => {
								const refs = refsByDim[dim.id][v.value];
								return (
									<div class="value-block" id={`dim-${dim.id}-${slugify(v.value)}`}>
										<div class="value-block__head">
											<div class="value-block__info">
												<span class="value-block__name" style={`--label-color:${groupDef.color};--label-bg:${groupDef.bg}`}>
													{humanizeLabel(v.value)}
												</span>
												<span class="value-block__summary">{v.summary}</span>
											</div>
											<button
												class="value-block__toggle"
												type="button"
												aria-expanded="false"
												aria-controls={`refs-${dim.id}-${slugify(v.value)}`}
												data-ref-toggle
											>
												<span class="value-block__count">{refs.length} papers</span>
												<span class="value-block__arrow" aria-hidden="true">▸</span>
											</button>
										</div>
										<div
											class="value-block__refs"
											id={`refs-${dim.id}-${slugify(v.value)}`}
											hidden
										>
											<ul class="value-block__ref-list">
												{
													refs.map((ref) => (
														<li class="value-block__ref">
															<button
																class="value-block__ref-title"
																type="button"
																data-open-paper={ref.id}
																title="Open paper profile"
															>
																{ref.title || `Paper ${ref.id}`}
															</button>
															<span class="value-block__ref-meta">
																{ref.authors.length ? ref.authors.join(', ') : ''}
																{ref.year ? ` · ${ref.year}` : ''}
																{ref.venue ? ` · ${ref.venue}` : ''}
															</span>
														</li>
													))
												}
											</ul>
										</div>
									</div>
								);
							})
						}
					</div>
				</section>
			))
		}
	</article>

	<!-- Paper profile popup: reuses the Paper Explorer's deep-link (/?paper=<id>). -->
	<div class="profile" data-profile hidden>
		<div class="profile__backdrop" data-profile-close></div>
		<div class="profile__dialog" role="dialog" aria-modal="true" aria-labelledby="profile-title">
			<div class="profile__bar">
				<span class="profile__bar-label">Paper profile</span>
				<button class="profile__close" type="button" data-profile-close aria-label="Close paper profile">
					<svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
						<path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
					</svg>
				</button>
			</div>
			<div class="profile__body" data-profile-body></div>
		</div>
	</div>
</BaseLayout>

<script>
	// Collapsible paper references.
	document.querySelectorAll<HTMLElement>('[data-ref-toggle]').forEach((btn) => {		btn.addEventListener('click', () => {
			const targetId = btn.getAttribute('aria-controls');
			const target = document.getElementById(targetId ?? '');
			if (!target) return;
			const open = target.hidden;
			target.hidden = !open;
			btn.setAttribute('aria-expanded', String(open));
			const arrow = btn.querySelector('.value-block__arrow');
			if (arrow) arrow.textContent = open ? '▾' : '▸';
		});
	});

	// Paper titles open the full profile popup on the Paper Explorer,
	// deep-linked via /paper-explorer?paper=<id> (same tab, back-friendly).
	document.querySelectorAll<HTMLElement>('[data-open-paper]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const id = btn.getAttribute('data-open-paper');
			if (id) window.location.href = `/paper-explorer?paper=${encodeURIComponent(id)}`;
		});
	});
</script>

<style>
	.categories__header {
		margin-bottom: var(--space-6);
	}
	.categories__header p {
		max-width: 60rem;
		color: var(--color-text);
	}

	/* ---- Overview table ---- */
	.categories__overview {
		margin-bottom: var(--space-4);
		scroll-margin-top: calc(var(--header-height) + var(--space-4));
	}

	/* ---- Sticky in-page dimension nav ---- */
	.dim-nav {
		position: sticky;
		top: var(--header-height);
		z-index: 10;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
		padding: var(--space-2) 0;
		margin-bottom: var(--space-6);
		background: var(--color-bg);
		border-bottom: 1px solid var(--color-border);
	}
	.dim-nav__link {
		padding: var(--space-1) var(--space-3);
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: var(--color-surface);
		color: var(--dim-color);
		font-size: var(--text-xs);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		transition: background var(--transition-fast), border-color var(--transition-fast);
	}
	.dim-nav__link:hover {
		background: var(--color-bg-alt);
		border-color: var(--dim-color);
		text-decoration: underline;
	}
	.overview__table-wrap {
		overflow-x: auto;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
	}
	.overview__table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--text-sm);
	}
	.overview__table th,
	.overview__table td {
		padding: var(--space-3);
		border-bottom: 1px solid var(--color-border);
		text-align: left;
		vertical-align: top;
	}
	.overview__table thead th {
		background: var(--color-navy-100);
		color: var(--color-navy-800);
		font-weight: 700;
	}
	.overview__table tbody tr:last-child td {
		border-bottom: none;
	}
	.overview__dim {
		white-space: nowrap;
		font-weight: 600;
	}
	.overview__dim-link {
		color: var(--dim-color);
	}
	.overview__dim-link:hover {
		text-decoration: underline;
	}
	.overview__values {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
	}
	.overview__label {
		display: inline-flex;
		align-items: center;
		padding: 2px var(--space-2);
		border: 1px solid var(--label-color);
		border-radius: 999px;
		background: var(--label-bg);
		color: var(--label-color);
		font-size: var(--text-xs);
		font-weight: 600;
		white-space: nowrap;
	}
	.overview__label:hover {
		filter: brightness(0.95);
	}

	/* ---- Dimension sections ---- */
	.dimension {
		margin-bottom: var(--space-8);
		padding-top: var(--space-2);
		/* Anchored jumps land below the fixed header + sticky dim-nav. */
		scroll-margin-top: calc(var(--header-height) + 3.5rem);
	}
	.dimension__top {
		display: inline-block;
		margin-bottom: var(--space-1);
		font-size: var(--text-xs);
		font-weight: 600;
		color: var(--color-text-muted);
		text-decoration: none;
	}
	.dimension__top:hover {
		color: var(--color-teal-700);
		text-decoration: underline;
	}
	.dimension__title {
		margin: 0 0 var(--space-2);
		color: var(--dim-color);
	}
	.dimension__desc {
		margin: 0 0 var(--space-4);
		color: var(--color-text-muted);
		max-width: 60rem;
	}
	.dimension__values {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	/* ---- Value blocks ---- */
	.value-block {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		overflow: hidden;
	}
	.value-block__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		padding: var(--space-3) var(--space-4);
	}
	.value-block__info {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		flex-wrap: wrap;
	}
	.value-block__name {
		display: inline-flex;
		align-items: center;
		padding: 2px var(--space-3);
		border: 1px solid var(--label-color);
		border-radius: 999px;
		background: var(--label-bg);
		color: var(--label-color);
		font-size: var(--text-sm);
		font-weight: 700;
		white-space: nowrap;
	}
	.value-block__summary {
		font-weight: 600;
		color: var(--color-text);
	}
	.value-block__toggle {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		border: none;
		background: none;
		padding: var(--space-1) var(--space-2);
		border-radius: var(--radius-sm);
		cursor: pointer;
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		white-space: nowrap;
	}
	.value-block__toggle:hover {
		background: var(--color-bg-alt);
		color: var(--color-text);
	}
	.value-block__count {
		font-weight: 600;
	}
	.value-block__arrow {
		font-size: var(--text-base);
		transition: transform var(--transition-fast);
	}

	.value-block__refs {
		border-top: 1px solid var(--color-border);
		background: var(--color-bg-alt);
		padding: var(--space-3) var(--space-4);
	}
	.value-block__refs[hidden] {
		display: none;
	}
	.value-block__ref-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}
	.value-block__ref {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.value-block__ref-title {
		font-weight: 600;
		/* Rendered as a <button> so it can open the paper profile popup. */
		border: none;
		background: none;
		padding: 0;
	text-align: left;
		color: var(--color-link);
		cursor: pointer;
		align-self: flex-start;
	}
	.value-block__ref-title:hover {
		color: var(--color-link-hover);
		text-decoration: underline;
	}
	.value-block__ref-meta {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
	}

	@media (max-width: 48rem) {
		.value-block__head {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>