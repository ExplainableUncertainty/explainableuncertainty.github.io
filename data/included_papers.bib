	month = apr,
	year = {2025},
	keywords = {machine learning, Explainable AI, Data models, Predictive models, Robustness, Uncertainty, explainable artifical intelligence, Noise, Noise level, Perturbation methods, Speech processing, Synthetic data, trustworthy machine learning, uncertainty attribution},
	pages = {1--5},
	file = {PDF:C\:\\Users\\emily.schiller\\Zotero\\storage\\EMNMFME7\\Kantz et al. - 2025 - Input Uncertainty Attribution by Uncertainty Propagation.pdf:application/pdf},
}
